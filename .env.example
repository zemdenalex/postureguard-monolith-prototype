# PostureGuard Deployment Configuration

# ===================
# Server Settings
# ===================
SERVER_USER=root
SERVER_IP=YOUR_SERVER_IP

# ===================
# Remote Paths
# ===================
REMOTE_WEB_PATH=/var/www/postureguard
REMOTE_BOT_PATH=/home/deploy/postureguard-bot

# ===================
# Telegram Bot
# ===================
BOT_TOKEN=YOUR_BOT_TOKEN
WEBAPP_URL=https://easy-posture.site
